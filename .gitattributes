# Auto-detect text files and normalize line endings
* text=auto

# Force LF for source files
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.keystore binary
*.jks binary

# Gradle wrapper
gradle/wrapper/gradle-wrapper.jar binary

# Git diff for lockfiles
package-lock.json -diff
gradle.lockfile -diff
