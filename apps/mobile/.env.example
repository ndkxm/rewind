# Rewind mobile environment — copy this file to `.env` and fill in your values.
# Never commit a real `.env` file.

# Base URL of the backend API.
# - iOS simulator / web / Android via `adb reverse`: leave unset (defaults to http://localhost:8080)
# - Physical Android device: use your dev machine's LAN IP, e.g. http://192.168.0.103:8080
EXPO_PUBLIC_API_URL=http://192.168.0.103:8080
