# ==============================================
# Rewind — Environment Variables
# ==============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================

# ----- Database -----
DATABASE_URL=jdbc:postgresql://localhost:5432/rewind
DATABASE_USERNAME=rewind
DATABASE_PASSWORD=change_me

# ----- Supabase Storage -----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=rewind-media

# ----- AI Providers (backend only — never expose in mobile) -----
GROQ_API_KEY=your-groq-api-key
GROQ_VISION_MODEL=model-id-to-be-decided

# ----- Embedding Provider -----
JINA_API_KEY=your-jina-api-key
JINA_EMBEDDING_MODEL=model-id-to-be-decided

# ----- Auth -----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MS=86400000

# ----- Server -----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
