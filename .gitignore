# ==========================
# Rewind Monorepo .gitignore
# ==========================

# ----- Environment & Secrets -----
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks

# ----- OS -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- IDEs -----
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~

# ----- Node.js / Mobile -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.expo/
dist/
web-build/
*.tsbuildinfo
*.hprof

# ----- Java / Gradle -----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
out/
target/
*.class
*.jar
!gradle/wrapper/*.jar
hs_err_pid*

# ----- Docker -----
docker-compose.override.yml

# ----- Coverage & Reports -----
coverage/
*.lcov
test-results/
